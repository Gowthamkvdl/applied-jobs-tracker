generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Job {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  company   String
  link      String
  location  String
  source    String
  type      String
  status    String   @default("Applied")
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
